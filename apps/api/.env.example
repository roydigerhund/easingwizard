API_URL=http://localhost:3000
# Optional origins for local/custom MCP hosts, and additional allowed hostnames.
# Comma-separated. Hosted api.easingwizard.com and VERCEL_URL already allow
# public browser access; native clients without an Origin remain supported.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=
# Per running instance; configure global/per-client limits at the hosting edge.
MCP_REQUESTS_PER_MINUTE=600
