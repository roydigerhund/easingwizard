{
  "name": "easingwizard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:core": "turbo run build --filter=easingwizard-core",
    "build:api": "turbo run build --filter=easingwizard-api",
    "build:frontend": "turbo run build --filter=easingwizard-frontend",
    "dev": "turbo run dev",
    "dev:core": "turbo run dev --filter=easingwizard-core",
    "dev:api": "turbo run dev --filter=easingwizard-api",
    "dev:frontend": "turbo run dev --filter=easingwizard-frontend",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "generate": "turbo run generate",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "build:mcp": "turbo run build --filter=@easingwizard/mcp-server",
    "test": "turbo run test && node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm release:check",
    "plugins:check": "node scripts/package-plugins.mjs --check",
    "plugins:package": "node scripts/package-plugins.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "plugins:sync": "node scripts/package-plugins.mjs --sync",
    "release:sync-plugin": "node scripts/sync-claude-plugin.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "pnpm": {
    "overrides": {
      "@vercel/static-config>ajv": "^8.20.0",
      "yaml": "^2.9.1"
    }
  }
}
